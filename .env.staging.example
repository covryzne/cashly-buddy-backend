# Copy to .env.staging and fill privately. Never commit real env files.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# auto: readable colored terminal; JSON when redirected.
LOG_FORMAT=auto
LOG_COLOR=auto
CORS_ORIGINS='[]'
# For a local FE while selecting staging, use exact loopback origins, e.g.
# CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# Runtime: PostgreSQL session pooler on port 5432; URL-encode passwords.
DATABASE_URL=
# Separate migration role; direct connection or session pooler on port 5432.
MIGRATION_DATABASE_URL=
# Supabase project URL and publishable key for the same database/Auth project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10

# Opt in to fictional PostgreSQL data; effective only in CASHLY_ENV=dev.
DEV_SAMPLE_DATA=false

# Backend only, required for permanent account deletion. Never put in NEXT_PUBLIC_*.
# Use a Supabase sb_secret_* key or legacy service_role JWT from this same project.
SUPABASE_SECRET_KEY=

# AI primary provider (backend only). Keep credentials outside Git/browser.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=35
GEMINI_THINKING_LEVEL=low

# Paid OpenRouter model. Fill your key and selected model ID.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_TIMEOUT_SECONDS=35

# Ordered application fallback. Keep this JSON on one line; replace/add model IDs.
# inputs: text = chat + reviewed VN transcript; image = OCR; audio = VN transcription.
# Omit model to use the provider's *_MODEL / *_IMAGE_MODEL / *_AUDIO_MODEL setting.
# Only list modalities the model supports. [] disables runtime model fallback.
AI_FALLBACK_MODELS=[{"provider":"openrouter","model":"google/gemini-3.5-flash-lite","inputs":["text","image","audio"]}]
# Each call uses the lowest of this cap, target/provider timeout, remaining total.
AI_ATTEMPT_TIMEOUT_SECONDS=20
AI_TOTAL_TIMEOUT_SECONDS=60

# Optional per-input primary models; blank reuses that provider's base model.
GEMINI_IMAGE_MODEL=
GEMINI_AUDIO_MODEL=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_AUDIO_MODEL=
# Optional primary provider for audio only; failures use the same fallback list.
AI_AUDIO_PROVIDER=

# Optional WhatsApp account linking (disabled until migration + n8n credentials).
WHATSAPP_ENABLED=false
WHATSAPP_RECORDING_ENABLED=false
WHATSAPP_APP_URL=
WHATSAPP_REPORT_FRONTEND_URL=
WHATSAPP_BOT_NUMBER=
WHATSAPP_INSTANCE=cashly-staging
# Separate private values, >=32 random characters for integration/hash keys.
WHATSAPP_INTEGRATION_KEY=
WHATSAPP_HASH_SECRET=
# Fernet.generate_key(), private. Keep stable; rotation requires a migration plan.
WHATSAPP_ENCRYPTION_KEY=
# Automatic daily reminders and optional Web Push (per environment).
NOTIFICATION_WORKER_ENABLED=false
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
