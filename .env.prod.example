# Copy to .env.prod and fill privately. Never commit real env files.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# auto: readable colored terminal; JSON when redirected.
LOG_FORMAT=auto
LOG_COLOR=auto
CORS_ORIGINS='[]'
# Runtime: PostgreSQL session pooler on port 5432; URL-encode passwords.
DATABASE_URL=
# Separate migration role; direct connection or session pooler on port 5432.
MIGRATION_DATABASE_URL=
# Supabase project URL and publishable key for the same database/Auth project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10

# Opt in to fictional PostgreSQL data; effective only in CASHLY_ENV=dev.
DEV_SAMPLE_DATA=false

# Backend only, required for permanent account deletion. Never put in NEXT_PUBLIC_*.
# Use a Supabase sb_secret_* key or legacy service_role JWT from this same project.
SUPABASE_SECRET_KEY=

# Backend-only chat extraction (optional until configured).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=35
GEMINI_THINKING_LEVEL=low

# Change provider then restart BE. Missing OpenRouter key -> Gemini; errors do not switch.
AI_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=35
