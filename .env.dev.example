# Copy to .env.dev and fill privately. Never commit real env files.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# auto: readable colored terminal; JSON when redirected.
LOG_FORMAT=auto
LOG_COLOR=auto
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# Local Supabase Docker, accessed by the BE process running on this laptop.
# Provision sql/runtime_role.sql then sql/local_runtime.sql after the core migration.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
# Local: copy the publishable key from npm run supabase:status.
# Hosted staging while on dev: use URL/key + BOTH database URLs from that same
# staging project. See AUTH_STAGING_SETUP.md for SMTP/Google setup and examples.
# SMTP token and Google client secret belong in Supabase settings, not this env.
SUPABASE_PUBLISHABLE_KEY=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT=
DB_CONNECT_TIMEOUT=

# Opt in to fictional PostgreSQL data; effective only in CASHLY_ENV=dev.
DEV_SAMPLE_DATA=

# Allow weekday weekly-review testing ONLY on dev with a loopback DB.
WEEKLY_REVIEW_TEST_MODE=false
DAILY_CHECKIN_TEST_MODE=false

# Backend only, required for permanent account deletion. Never put in NEXT_PUBLIC_*.
# Use a Supabase sb_secret_* key or legacy service_role JWT from this same project.
SUPABASE_SECRET_KEY=
